  <system:String x:Key="prefs.playback.autoscrollmode.pagescroll">ปรับแต่งเป็นรูปแบบการเลื่อนปัดแบบสลับข้ามหน้ากระดาน</system:String>
  <system:String x:Key="prefs.playback.autoscrollmode.stationarycursor">ยึดปักหมุดเคอร์เซอร์เส้นเสียงให้ประจำการอยู่กับที่</system:String>
  <system:String x:Key="prefs.playback.backend">โครงสร้างเอนจินแกนกลางสำหรับการขับเคลื่อนเสียง (Audio Backend)</system:String>
  <system:String x:Key="prefs.playback.backend.auto">ระบบเลือกเฟ้นหาให้อัตโนมัติ</system:String>
  <system:String x:Key="prefs.playback.backend.mini">MiniAudio</system:String>
  <system:String x:Key="prefs.playback.backend.sdl3">SDL 3</system:String>
  <system:String x:Key="prefs.playback.cursorposition">คุมระยะขอบพิกัดสำหรับการเลื่อนเปลี่ยนหน้าจออัตโนมัติ (Auto-Scroll Margin)</system:String>
  <system:String x:Key="prefs.playback.device">กำหนดอุปกรณ์ที่จะใช้เป็นตัวรับช่วงต่อเพื่อส่งออกเสียง (Playback Device)</system:String>
  <system:String x:Key="prefs.playback.lockstarttime">พฤติกรรมการต้านสนองเมื่อผู้ใช้กดหยุดพักการเล่นเสียง (On Pausing)</system:String>
  <system:String x:Key="prefs.playback.lockstarttime.off">ยุติและไม่ต้องทำพฤติกรรมใดๆ (หยุดแช่เอาไว้กับที่ตรงนั้นเลย)</system:String>
  <system:String x:Key="prefs.playback.lockstarttime.on">ดึงโยกนำทางตัวเคอร์เซอร์พร้อมกับมุมมองภาพ กลับไปยังตำแหน่งจุดเดิมที่ถูกสั่งเล่น</system:String>
  <system:String x:Key="prefs.playback.lockstarttime.onlycursor">ดึงโยกเฉพาะตัวเคอร์เซอร์ล้วนๆ กลับไปยังตำแหน่งจุดเดิมที่ถูกสั่งเริ่มเล่น</system:String>
  <system:String x:Key="prefs.playback.metronome">เสียงเคาะดนตรีรักษาจังหวะการทำผลงาน (Metronome)</system:String>
  <system:String x:Key="prefs.playback.metronome.volume">ความเข้มระดับเสียงของการเคาะจังหวะ</system:String>
  <system:String x:Key="prefs.playback.metronome.highfrequency">คลื่นความถี่สูงของเสียงเครื่องเคาะ (High Frequency)</system:String>
  <system:String x:Key="prefs.playback.metronome.lowfrequency">คลื่นความถี่ต่ำของเสียงเครื่องเคาะ (Low Frequency)</system:String>
  <system:String x:Key="prefs.playback.systemdefault">ดึงอุปกรณ์ค่าเริ่มต้นของระบบปฏิบัติการ OS เข้ามาบังคับใช้</system:String>
  <system:String x:Key="prefs.playback.test">กดยิงทดสอบเสียง</system:String>
  <system:String x:Key="prefs.rendering">กระบวนการทางสถาปัตยกรรมการประมวลผล (Rendering)</system:String>
  <system:String x:Key="prefs.rendering.defaultrenderer">ระบบเอนจินประมวลผลเริ่มต้น (ออกแบบเฉพาะตัวมาเพื่อรองรับคลังเสียงทั่วไปที่เป็นสายคลาสสิก)</system:String>
  <system:String x:Key="prefs.rendering.diffsingerdepth">ขอบเขตความลึกในการรีดเค้นพลังเพื่อเรนเดอร์ของ DiffSinger (Render Depth)</system:String>
  <system:String x:Key="prefs.rendering.diffsingersteps">อัตราขั้นตอนการเรนเดอร์กลั่นกรองของ DiffSinger เฉพาะส่วนภาคอะคูสติก (Acoustic Steps)</system:String>
  <system:String x:Key="prefs.rendering.diffsingerstepspitch">อัตราขั้นตอนการเรนเดอร์กลั่นกรองของ DiffSinger เฉพาะส่วนภาคของ Pitch</system:String>
  <system:String x:Key="prefs.rendering.diffsingerstepsvariance">อัตราขั้นตอนการเรนเดอร์กลั่นกรองของ DiffSinger เฉพาะส่วนของความแปรปรวน (Variance)</system:String>
  <system:String x:Key="prefs.rendering.diffsingervariancelocalpitchpatch">อัปเดตตีบวกค่าความแปรปรวน Variance เพื่อชดเชยให้สำหรับการแก้ไข Pitch แบบเฉพาะส่วนลงในพื้นที่ (Local Update)</system:String>
  <system:String x:Key="prefs.rendering.gamebackend">เอนจินขุมพลังประมวลผลการอนุมานของระบบ GAME (Inference Backend)</system:String>
  <system:String x:Key="prefs.rendering.mergephrases">กำหนดค่าระยะเวลาสำหรับรวมวลีร้องให้เข้าและเชื่อมเป็นเนื้อเดียวกัน (ระบุเป็นหน่วยวินาที)</system:String>
  <system:String x:Key="prefs.rendering.onnxgpu">ระบบการใช้ทรัพยากรการ์ดจอ (GPU)</system:String>
  <system:String x:Key="prefs.rendering.onnxrunner">เอนจินขุมพลังประมวลผลเครือข่าย Machine Learning (Runner)</system:String>
  <system:String x:Key="prefs.rendering.phasecomp">ระบบการวิเคราะห์และชดเชยเฟส (Phase Compensation)</system:String>
  <system:String x:Key="prefs.rendering.prerender">ระบบการแอบประมวลผลเรนเดอร์ล่วงหน้าให้แบบอัตโนมัติ (Pre-render)</system:String>
  <system:String x:Key="prefs.rendering.resampler">หัวใจเอนจินปรับเสียง (Resampler)</system:String>
  <system:String x:Key="prefs.rendering.resampler.morewarn">คำเตือน: เอนจิน Moresampler อาจทำงานได้ไม่เต็มประสิทธิภาพตามที่ควรจะเป็นในบริบทนี้ ซึ่งอาจส่งผลลุกลามทำให้ประมวลผลได้ช้าลงและ CPU จะต้องแบกรับภาระทำงานอย่างหนัก หากผู้ใช้งานยังมีความประสงค์ที่แน่วแน่ต้องการดึงเข้ามาใช้งาน กรุณาตั้งค่าเพื่อหลีกเลี่ยงข้อจำกัดดังนี้ครับ:
  1. เปิดให้พารามิเตอร์ "resampler-compatibility" เปลี่ยนเป็นสถานะ "on" ทิ้งไว้ในไฟล์ moreconfig.txt
  2. ตั้งค่าพารามิเตอร์ "auto-update-llsm-mrq" ให้เปลี่ยนเป็นสถานะ "off" ทิ้งไว้ในไฟล์ moreconfig.txt
  3. จากนั้นขอให้รอด้วยความใจเย็น เพื่อให้เอนจิน moresampler จัดการสร้างและเยียวยาไฟล์ llsm ที่ขาดหายไปขึ้นมาใหม่ทั้งหมดด้วยตัวของมันเองครับ</system:String>
  <system:String x:Key="prefs.rendering.resampler.note">ข้อมูลหมายเหตุ: หากผู้ใช้งานปรารถนาต้องการใช้งานเอนจิน Resampler จากทางค่ายภายนอก ให้นำไฟล์นามสกุล DLL หรือแบบ EXE ของ Resampler ตัวนั้นๆ นำไปบรรจุวางเอาไว้ในโฟลเดอร์ "Resamplers" ที่ตั้งอยู่ภายในพื้นที่พิกัดที่ติดตั้งตัวซอฟต์แวร์ OpenUtau เสร็จแล้วให้กลับมาเลือกดึงชื่อเอนจินดังกล่าวในหน้าต่างเมนูแห่งนี้ได้เลยครับ</system:String>
  <system:String x:Key="prefs.rendering.skipmuted">เพิกเฉยและข้ามการเรนเดอร์สำหรับแทร็กที่มีสถานะถูกปิดเสียงไว้อยู่ (Muted Tracks)</system:String>
  <system:String x:Key="prefs.rendering.threads.cpuwarn">คำเตือน: การบีบคั้นสั่งเปิดใช้งานจำนวนช่องเธรด (Thread) เพื่อใช้ในการเรนเดอร์เสียงที่มากจนเกินตัวและเกินขีดจำกัดของระบบ อาจนำพามาซึ่งความเสื่อมถอย ทำให้ประสิทธิภาพโดยรวมของแอปพลิเคชัน OpenUtau ต้องแลกมาด้วยอาการหน่วงและทำงานได้ช้าลงไปอย่างเห็นได้ชัดครับ</system:String>
  <system:String x:Key="prefs.rendering.threads.numthreads">จำกัดจำนวนเพดาน Thread สูงสุดสำหรับการประมวลผล</system:String>
  <system:String x:Key="prefs.rendering.wavtool">เอนจินสำหรับดึงผสมเสียง (Wavtool)</system:String>
  <system:String x:Key="prefs.utau">อารยธรรมดั้งเดิมของระบบ UTAU</system:String>
  <system:String x:Key="prefs.placeholdertext.none">(ระบุเป็นค่าว่าง หรือไม่มีเลย)</system:String>

  <system:String x:Key="progress.cachecleared">กระบวนการชะล้างและล้างแคชสิ้นสุดลงเรียบร้อยแล้วครับ</system:String>
  <system:String x:Key="progress.clearingcache">กำลังดำเนินการขะมักเขม้นชะล้างและล้างแคชทิ้ง...</system:String>
  <system:String x:Key="progress.loadingsingers">ระบบกำลังดำเนินการโหลดอัญเชิญข้อมูลรายนามนักร้องเข้ามาสู่เซสชัน...</system:String>
  <system:String x:Key="progress.saved">การบันทึกโปรเจกต์เป้าหมาย {0} ถูกเซฟอย่างสมบูรณ์แบบเรียบร้อยแล้วครับ!</system:String>
  <system:String x:Key="progress.waitingrendering">กรุณารอสักครู่... ระบบกำลังจัดสรรรอคิวคอยการประมวลผลเสียงเรนเดอร์ครับ</system:String>

  <system:String x:Key="singererror.aliasfullwidthspaces">นามแฝง (Alias) ที่ผู้ใช้งานตั้ง มีอักขระช่องว่างแบบเต็มรูป (Full-width space) ปะปนแทรกซึมอยู่ครับ</system:String>
  <system:String x:Key="singererror.aliasisnfd">นามแฝง (Alias) ที่ระบุ ถูกแปลงให้อยู่ในรูปแบบของโครงสร้าง NFD ครับ</system:String>
  <system:String x:Key="singererror.aliasmultiplespaces">นามแฝงพบร่องรอยของการมีช่องว่างซ้อนทับกันหลายๆ อันครับ</system:String>
  <system:String x:Key="singererror.aliasstartwithspace">นามแฝงมีพฤติกรรมเริ่มต้นหรือลงท้ายปิดจบด้วยการเว้นช่องว่างครับ</system:String>
  <system:String x:Key="singererror.bitdepth">คุณภาพของความละเอียดบิต (Bit depth) ของไฟล์เสียงนี้ไม่ได้ถูกตีกรอบและตั้งค่าไว้ที่ระดับความลึก 16-bit ครับ</system:String>
  <system:String x:Key="singererror.consonantoutofduration">จุดพยัญชนะ (Consonant) หลุดวงโคจรและตั้งอยู่นอกช่วงความยาวของตัวไฟล์เสียงครับ</system:String>
  <system:String x:Key="singererror.consonantshort">จุดพยัญชนะ (Consonant) จำเป็นจะต้องมีค่าพื้นที่มากกว่าหรือตีค่าให้เท่ากับ 0 เสมอครับ</system:String>
  <system:String x:Key="singererror.cutoffconsonant">จุดตัดท้ายเสียง (Cutoff) จำเป็นจะต้องตั้งค่าให้อยู่ประจำที่อยู่ทางขวาของพยัญชนะ (Consonant) เสมอครับ</system:String>
  <system:String x:Key="singererror.cutoffoutofduration">จุดตัดท้ายเสียง (Cutoff) หลุดร่วงอยู่นอกช่วงความยาวของขีดจำกัดไฟล์เสียงครับ</system:String>
  <system:String x:Key="singererror.cutoffoverlap">จุดตัดท้ายเสียง (Cutoff) จำเป็นจะต้องตั้งค่าให้อยู่ประจำที่อยู่ทางขวาของการซ้อนทับ (Overlap) เสมอครับ</system:String>
  <system:String x:Key="singererror.cutoffpreutter">จุดตัดท้ายเสียง (Cutoff) จำเป็นจะต้องตั้งค่าให้อยู่ประจำที่อยู่ทางขวาของจุดเริ่มเปล่ง (Preutter) เสมอครับ</system:String>
  <system:String x:Key="singererror.duplicatealias">ระบบสแกนพบเจอนามแฝงที่ถูกเรียกใช้งานซ้ำซ้อนกันในชุดข้อมูลครับ: {0}</system:String>
  <system:String x:Key="singererror.duplicatename">ระบบสแกนพบเจอกรณีชื่อไฟล์ที่มีความซ้ำซ้อนกัน (เมื่ออนุโลมละเว้นมองข้ามตัวพิมพ์เล็ก-ตัวพิมพ์ใหญ่) ในกลุ่มชุดคำสั่งฐานข้อมูลของ oto "{0}": {1}
ผลสืบเนื่องจากเหตุการณ์นี้ คลังเสียงนักร้องอาจจะมีพฤติกรรมทำงานที่รวนและผิดพลาดได้ หากผู้ใช้ย้ายนำไปใช้บนระบบปฏิบัติการ OS แพลตฟอร์มอื่นที่มีความละเอียดอ่อนอย่างรุนแรงในเรื่องของการแยกแยะขนาดความไวตัวอักษรครับ</system:String>
  <system:String x:Key="singererror.failedload">ระบบล้มเหลวในการโหลดคลังเสียงเข้าสู่แพลตฟอร์มครับ</system:String>
  <system:String x:Key="singererror.invalidduration">ความยาวและจังหวะเวลาไม่มีความถูกต้อง {0}</system:String>
  <system:String x:Key="singererror.invalidoto">รูปแบบค่าของการเรียบเรียงโครงสร้างในตาราง Oto.ini ไม่มีความถูกต้องตามหลักไวยากรณ์ครับ</system:String>
  <system:String x:Key="singererror.mono">ไฟล์เสียงต้นฉบับไม่ได้ถูกสร้างมาให้อยู่ในรูปแบบของช่องสัญญาณ Mono Channel ครับ</system:String>
  <system:String x:Key="singererror.offsetoutofduration">พิกัดจุดเริ่มต้นเสียง (Offset) หลุดวงโคจรและตั้งอยู่นอกช่วงความยาวของตัวไฟล์เสียงครับ</system:String>
  <system:String x:Key="singererror.offsetshort">พิกัดจุดเริ่มต้นเสียง (Offset) จำเป็นจะต้องมีค่าพื้นที่มากกว่าหรือตีค่าให้เท่ากับ 0 เสมอครับ</system:String>
  <system:String x:Key="singererror.overlapoutofduration">พิกัดจุดเชื่อมทับและครอสเฟด (Overlap) หลุดร่วงอยู่นอกช่วงความยาวของขีดจำกัดไฟล์เสียงครับ</system:String>
  <system:String x:Key="singererror.preutteroutofduration">พิกัดจุดเริ่มปล่อยการเปล่งเสียง (Preutter) หลุดร่วงอยู่นอกช่วงความยาวของขีดจำกัดไฟล์เสียงครับ</system:String>
  <system:String x:Key="singererror.preuttershort">พิกัดจุดเริ่มปล่อยการเปล่งเสียง (Preutter) จำเป็นจะต้องมีค่าพื้นที่มากกว่าหรือตีค่าให้เท่ากับ 0 เสมอครับ</system:String>
  <system:String x:Key="singererror.samplerate">คุณภาพของ Sample rate ของไฟล์เสียงนี้ไม่ได้ถูกกำหนดมาบรรจบให้ตั้งค่าไว้ที่ย่าน 44100Hz พอดีครับ</system:String>
  <system:String x:Key="singererror.soundmissing">ไฟล์เสียงคลื่นต้นฉบับขาดหายสูญไปจากระบบการค้นหาครับ</system:String>
  <system:String x:Key="singererror.soundnotopened">ระบบปฏิเสธและไม่สามารถดำเนินการสั่งเปิดไฟล์เสียงชิ้นนี้ได้ครับ</system:String>
  <system:String x:Key="singererror.txtnotfound">ระบบรื้อหาไฟล์ข้อมูลอ้างอิง character.txt ไม่พบครับ</system:String>
  <system:String x:Key="singererror.wavisnfd">พิจารณาโครงสร้างชื่อของไฟล์เสียง Wav ตรวจพบว่าอยู่ในรูปแบบมาตรการ NFD ครับ</system:String>
  <system:String x:Key="singererror.wrongcase">พบเห็นตัวอักษรกรณีพิมพ์เล็ก-พิมพ์ใหญ่ที่มีความลักลั่นและไม่ถูกต้องสอดคล้องกันในชื่อไฟล์:
ข้อเท็จจริงตามที่ระบบต้องการ: {0}
สภาวะในความเป็นจริง: {1}

  <system:String x:Key="dawintegration.col.compatibility">สถานะ</system:String>
  <system:String x:Key="dawintegration.col.name">ปลั๊กอิน</system:String>
  <system:String x:Key="dawintegration.col.port">พอร์ต</system:String>
  <system:String x:Key="dawintegration.col.state">การเชื่อมต่อ</system:String>
  <system:String x:Key="dawintegration.compatible">รองรับการใช้งาน</system:String>
  <system:String x:Key="dawintegration.connect">เชื่อมต่อ</system:String>
  <system:String x:Key="dawintegration.connected">เชื่อมต่อกับ {0} สำเร็จแล้ว</system:String>
  <system:String x:Key="dawintegration.connecting">กำลังเชื่อมต่อ...</system:String>
  <system:String x:Key="dawintegration.disconnect">ยกเลิกการเชื่อมต่อ</system:String>
  <system:String x:Key="dawintegration.disconnected">ยังไม่ได้เชื่อมต่อระบบ</system:String>
  <system:String x:Key="dawintegration.hint">เชื่อมต่อกับปลั๊กอิน DAW ที่กำลังทำงานอยู่ในเครื่องนี้ การแก้ไขทั้งหมดจะทำใน OpenUtau และปลั๊กอินจะรับเสียงและโปรเจกต์ที่เรนเดอร์แล้วไปแสดงผล หากเป็นมือใหม่ กรุณาขยาย "วิธีใช้งาน" ด้านบนครับ</system:String>
  <system:String x:Key="dawintegration.incompatible">ไม่รองรับเวอร์ชัน API</system:String>
  <system:String x:Key="dawintegration.lost">ขาดการเชื่อมต่อ: {0}</system:String>
  <system:String x:Key="dawintegration.none">ไม่พบปลั๊กอิน DAW โปรดโหลดปลั๊กอิน OpenUtau Bridge ลงในแทร็กเครื่องดนตรีของ DAW ก่อน แล้วจึงคลิก "รีเฟรช" หากเป็นมือใหม่ กรุณาคลิก "วิธีใช้งาน" ด้านบนครับ</system:String>
  <system:String x:Key="dawintegration.none.installed">ติดตั้งปลั๊กอิน Bridge เรียบร้อยแล้ว แต่ยังไม่มีการเรียกใช้งาน โปรดโหลด OpenUtau Bridge ลงในแทร็กเครื่องดนตรีของ DAW แล้วคลิก "รีเฟรช"</system:String>
  <system:String x:Key="dawintegration.reconnecting">กำลังเชื่อมต่อกับ {0} ใหม่อีกครั้ง...</system:String>
  <system:String x:Key="dawintegration.refresh">รีเฟรช</system:String>
  <system:String x:Key="dawintegration.unsavedproject">โปรเจกต์นี้ยังไม่ได้ถูกบันทึก กรุณาบันทึกโปรเจกต์ก่อนเชื่อมต่อกับ DAW เสมอ (โปรเจกต์ที่ยังไม่ได้เซฟจะไม่สามารถส่งไปยัง DAW ได้ครับ)</system:String>
  <system:String x:Key="dawintegration.bpmmismatch">ความเร็ว (Tempo) ของโปรเจกต์ใน DAW ไม่ตรงกับโปรเจกต์นี้ ทำให้ไทม์ไลน์อาจคลาดเคลื่อน กรุณาตั้งค่าจังหวะให้ตรงกันทั้งสองฝั่งครับ</system:String>
  <system:String x:Key="dawintegration.state.connected">เชื่อมต่อแล้ว</system:String>
  <system:String x:Key="dawintegration.state.connecting">กำลังเชื่อมต่อ</system:String>
  <system:String x:Key="dawintegration.state.reconnecting">กำลังเชื่อมต่อใหม่</system:String>
  <system:String x:Key="dawintegration.state.free">ยังไม่ได้เชื่อมต่อ</system:String>
  <system:String x:Key="dawintegration.connected.count">เชื่อมต่อกับปลั๊กอิน {0} รายการ</system:String>
  <system:String x:Key="dawintegration.guide.caption">วิธีใช้งานระบบ DAW</system:String>
  <system:String x:Key="dawintegration.guide.what">OpenUtau Bridge เป็นปลั๊กอิน (VST3/CLAP) ฟรีสำหรับ DAW ของคุณ ปลั๊กอินนี้จะรับไฟล์โปรเจกต์และเสียงที่เรนเดอร์แล้วจาก OpenUtau ไปวางไว้ในไทม์ไลน์ของ DAW ทำให้คุณสามารถจูนเสียงใน OpenUtau และมิกซ์เสียงใน DAW ได้อย่างไร้รอยต่อ โดยไม่ต้องตั้งค่าเพิ่มเติมภายใน OpenUtau ครับ</system:String>
  <system:String x:Key="dawintegration.guide.caps.header">ความสามารถหลัก</system:String>
  <system:String x:Key="dawintegration.guide.caps.1">ซิงค์อัตโนมัติ — โปรเจกต์และพาร์ทที่เรนเดอร์แล้วทุกการแก้ไข จะถูกส่งไปยังปลั๊กอินทันทีขณะที่คุณทำงาน</system:String>
  <system:String x:Key="dawintegration.guide.caps.2">หนึ่งปลั๊กอินต่อหนึ่งแทร็ก — เลือกว่าจะให้ปลั๊กอินอินสแตนซ์ใดเล่นแทร็กใดของ OpenUtau ได้เลยจากหน้าต่างปลั๊กอินหรือแผง Automation ของ DAW</system:String>
  <system:String x:Key="dawintegration.guide.caps.3">ซิงค์ตำแหน่งหัวเล่น (Playhead) — หัวเล่นของ OpenUtau จะวิ่งตาม Transport ของ DAW อย่างสมบูรณ์</system:String>
  <system:String x:Key="dawintegration.guide.caps.4">เป็นมิตรต่อการ Export — การ Bounce เสียงใน DAW จะรอจนกว่า OpenUtau จะเรนเดอร์เสียงเสร็จ เพื่อให้การ Export ตรงกับการเล่นจริง</system:String>
  <system:String x:Key="dawintegration.guide.scope.header">ขอบเขตและข้อจำกัด</system:String>
  <system:String x:Key="dawintegration.guide.scope.1">ทำงานได้ในคอมพิวเตอร์เครื่องเดียวกันเท่านั้น และ DAW ต้องรองรับ VST3 หรือ CLAP (เช่น REAPER, Cubase, FL Studio, Studio One, Ableton Live, Bitwig, ฯลฯ)</system:String>
  <system:String x:Key="dawintegration.guide.scope.2">ความยาวไทม์ไลน์อ้างอิงจากเวลาสัมบูรณ์ (Absolute Time) ควรตั้ง BPM ทั้งสองฝั่งให้ตรงกันเพื่อให้บาร์ดนตรีตรงกันเป๊ะ</system:String>
  <system:String x:Key="dawintegration.guide.scope.3">OpenUtau จะส่งออกเฉพาะเสียงร้องเท่านั้น การปรับระดับเสียง แพน (Pan) ปิดเสียง (Mute) และเอฟเฟกต์ทั้งหมดต้องทำในมิกเซอร์ของ DAW ครับ</system:String>
  <system:String x:Key="dawintegration.guide.steps.header">ขั้นตอนการตั้งค่า (3 ขั้นตอน)</system:String>
  <system:String x:Key="dawintegration.guide.step1">1. ติดตั้งปลั๊กอิน: คลิกปุ่มติดตั้งด้านบน (กดยืนยันสิทธิ์ Administrator หากมีหน้าต่างเด้งเตือน) หรือดาวน์โหลดด้วยตนเองแล้วนำโฟลเดอร์ "OpenUtau Bridge.vst3" ไปวางในแฟ้มปลั๊กอินของ DAW:</system:String>
  <system:String x:Key="dawintegration.guide.step2">2. ใน DAW ของคุณ ให้เพิ่มแทร็กเครื่องดนตรีแล้วเลือก "OpenUtau Bridge" (โดยผู้พัฒนา OpenUTAU) แนะนำให้ทำขณะที่ยังไม่ได้เปิดโปรแกรม OpenUtau (ให้ DAW เริ่มทำงานก่อนเสมอ)</system:String>
  <system:String x:Key="dawintegration.guide.step3">3. เปิดโปรแกรม OpenUtau บันทึกโปรเจกต์ของคุณให้เรียบร้อย กลับมาที่หน้าต่างนี้ คลิก "รีเฟรช" เลือกปลั๊กอิน แล้วคลิก "เชื่อมต่อ" ครับ</system:String>
  <system:String x:Key="dawintegration.guide.paths.win">VST3: C:\Program Files\Common Files\VST3&#10;CLAP: C:\Program Files\Common Files\CLAP&#10;หากไม่มีสิทธิ์ผู้ดูแลระบบ (Admin) ให้ใช้: %LOCALAPPDATA%\Programs\Common\VST3 (หรือ ...\CLAP) แทนครับ</system:String>
  <system:String x:Key="dawintegration.guide.paths.mac">VST3: ~/Library/Audio/Plug-Ins/VST3&#10;CLAP: ~/Library/Audio/Plug-Ins/CLAP</system:String>
  <system:String x:Key="dawintegration.guide.paths.linux">VST3: ~/.vst3&#10;CLAP: ~/.clap</system:String>
  <system:String x:Key="dawintegration.guide.download">ดาวน์โหลดสำหรับ {0}</system:String>
  <system:String x:Key="dawintegration.guide.install.header">ติดตั้งปลั๊กอิน (ตรวจพบบนระบบเครื่องนี้)</system:String>
  <system:String x:Key="dawintegration.guide.install.clap">ติดตั้งรูปแบบ CLAP</system:String>
  <system:String x:Key="dawintegration.guide.install.clap.reinstall">ติดตั้ง CLAP ใหม่อีกครั้ง</system:String>

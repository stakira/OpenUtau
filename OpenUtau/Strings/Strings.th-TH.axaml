  <system:String x:Key="errors.diffsinger.downloadvocoder">การโหลดใช้งาน Vocoder "{0}" ผิดพลาด โปรดทำการดาวน์โหลด Vocoder จาก {1} ครับ</system:String>
  <system:String x:Key="errors.diffsinger.downloadvocoder1">การโหลด Vocoder </system:String>
  <system:String x:Key="errors.diffsinger.downloadvocoder2"> ประสบปัญหาขัดข้อง โปรดทำการดาวน์โหลด Vocoder จาก </system:String>
  <system:String x:Key="errors.editing.autopitch.unsupported">คลังเสียง (Voicebank) นี้ยังไม่รองรับการสร้างกราฟระดับเสียง (Pitch Curve) โดยอัตโนมัติ โปรดใช้คลังเสียงประเภท DiffSinger หรือ Enunu ในการทำงานแทนครับ</system:String>
  <system:String x:Key="errors.encryptedarchive">ระบบไม่รองรับการจัดการไฟล์บีบอัดที่มีการเข้ารหัส (มีรหัสผ่าน) โปรดเปิดแฟ้ม Singer ผ่านหน้าการตั้งค่า (Tools > Preferences > Paths) และแตกไฟล์ด้วยตนเองไปยังตำแหน่งที่จัดเก็บนั้นครับ</system:String>
  <system:String x:Key="errors.expression.abbrlong">อักษรย่อ (Abbreviation) ต้องมีความยาวระหว่าง 1 ถึง 4 ตัวอักษรครับ</system:String>
  <system:String x:Key="errors.expression.abbrset">ต้องทำการกำหนดค่าอักษรย่อเสมอครับ</system:String>
  <system:String x:Key="errors.expression.abbrunique">ชื่ออักษรย่อจะต้องไม่ซ้ำซ้อนกันครับ</system:String>
  <system:String x:Key="errors.expression.customDefault">ค่าเริ่มต้นสำหรับโปรเจกต์/แทร็ก จะต้องอยู่ระหว่างค่าต่ำสุด (Min) และค่าสูงสุด (Max) ครับ</system:String>
  <system:String x:Key="errors.expression.default">ค่าเริ่มต้นจะต้องอยู่ระหว่างขอบเขตค่าต่ำสุดและค่าสูงสุดครับ</system:String>
  <system:String x:Key="errors.expression.flagunique">ตัวระบุ Flags ต้องมีสถานะเป็นเอกลักษณ์และไม่ซ้ำกันครับ</system:String>
  <system:String x:Key="errors.expression.marge">เครื่องหมายอารมณ์เหล่านี้ถูกระบบจับควบรวมเข้าด้วยกันแล้ว เนื่องจากมีการกำหนดค่า Flags ที่ทับซ้อนกันครับ</system:String>
  <system:String x:Key="errors.expression.min">ค่าต่ำสุด (Min) จำเป็นต้องมีค่าน้อยกว่าค่าสูงสุด (Max) ครับ</system:String>
  <system:String x:Key="errors.expression.name">ต้องกำหนดระบุชื่อกำกับเสมอครับ</system:String>
